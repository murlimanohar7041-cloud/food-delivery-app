rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow connection test
    match /test/connection {
      allow read: if true;
    }

    // User Profiles & Saved Addresses
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || ('email' in request.auth.token && request.auth.token.email == 'murlimanohar7041@gmail.com'));
      allow create, update: if request.auth != null && (request.auth.uid == userId || ('email' in request.auth.token && request.auth.token.email == 'murlimanohar7041@gmail.com'));
      allow delete: if request.auth != null && ('email' in request.auth.token && request.auth.token.email == 'murlimanohar7041@gmail.com');
    }

    // Delivery Partners Fleet
    match /deliveryPartners/{partnerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // App & Kitchen Location Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders Collection with Real-Time Delivery Tracking Support
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && ('email' in request.auth.token && request.auth.token.email == 'murlimanohar7041@gmail.com');
    }
  }
}
